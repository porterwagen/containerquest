# Base image pins — verified against live registries 2026-07-29.
#
# teach: Pinning a tag is the *minimum*. Tags are mutable: `node:24-alpine` will
# teach: point at different bytes next month. Production systems pin digests
# teach: (node:24-alpine@sha256:...) so a rebuild is bit-for-bit reproducible.
# teach: We use tags here for readability, and the Ledger view explains the tradeoff.

NODE_IMAGE=node:24-alpine
PYTHON_IMAGE=python:3.13-slim
GO_IMAGE=golang:1.26-alpine
ALPINE_IMAGE=alpine:3.23
DISTROLESS_IMAGE=gcr.io/distroless/static-debian13:nonroot

POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine
